<div
  id="popup"
  class="hidden fixed inset-0 z-50 bg-(--color-dark)/40 items-center justify-center font-[Inter]"
>
  <div class="w-full max-w-md rounded-2xl bg-(--color-light) p-6 shadow-2xl">

    <div class="flex items-center justify-between mb-5">
      <h2
        id="popupTitle"
        class="text-2xl font-semibold text-(--color-dark)"
      >
        Error
      </h2>

      <button
        id="closePopupMessage"
        type="button"
        class="cursor-pointer text-2xl text-(--color-dark) hover:text-(--color-main) hover:scale-[1.15] active:scale-95 transition"
      >
        ×
      </button>
    </div>

    <p
      id="popupMessage"
      class="text-(--color-dark) leading-relaxed"
    >
      Something went wrong.
    </p>

    <div class="flex justify-end mt-8">
      <button
        id="popupAcceptButton"
        class="px-5 py-2 rounded-full bg-(--color-main) text-(--color-light) font-medium hover:scale-[1.02] active:scale-95 transition cursor-pointer"
      >
        OK
      </button>
    </div>

  </div>
</div>

<script>
  import { hidePopup } from "../services/popup";

  const popup = document.getElementById("popup");
  const closeButton = document.getElementById("closePopupMessage");
  const acceptButton = document.getElementById("popupAcceptButton");

  closeButton?.addEventListener("click", hidePopup);
  acceptButton?.addEventListener("click", hidePopup);

  popup?.addEventListener("click", (event) => {
    if (event.target === popup) {
      hidePopup();
    }
  });
</script>