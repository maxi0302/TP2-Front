---
<div id="palletteName" class="hidden fixed inset-0 flex items-center justify-center bg-black/60 backdrop-blur-sm z-50 ">
    <article class="bg-(--color-light) border-(--color-dark)/20 rounded-2xl p-8 w-100 text-center shadow-[0_0_60px_rgba(0,0,0,0.8)]">
        <h1 class="text-xl font-semibold text-(--color-dark)">Enter a name to identify this pallette</h1>
        <input id="inputName" type="text" class="w-full rounded-xl border-2 border-(--color-light-accent) px-4 py-3 outline-none focus:border-(--color-main) focus:border-3" placeholder="Pallette name" />
        <div class="flex gap-3 mt-2">
            <button id="cancel" class="cursor-pointer w-1/2 bg-(--color-dark-accent) hover:bg-(--color-dark)/80 text-(--color-light) py-2 rounded-xl transition">Cancel</button>
            <button id="savePall" class="cursor-pointer w-1/2 bg-(--color-light-accent) hover:bg-(--color-main)/80 text-(--color-dark) font-semibold py-2 rounded-xl transition">Save</button>
        </div>
    </article>
</div>