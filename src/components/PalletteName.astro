<div id="palletteName" class="hidden fixed inset-0 flex items-center justify-center bg-black/60 backdrop-blur-sm z-50 ">
    <article class="bg-white border border-red-500/20 rounded-2xl p-8 w-[400px] text-center shadow-[0_0_60px_rgba(0,0,0,0.8)]">
        <h1>Enter a name to identify this pallette</h1>
        <input type="text" id="inputName" class="w-full rounded-lg border border-slate-800 bg-[#020617] px-4 py-3 text-sm text-white placeholder:text-slate-500 focus:outline-none focus:ring-2 focus:ring-green-500">
        <div class="flex gap-3 mt-2">
            <button id="cancel" class="cursor-pointer w-1/2 bg-[#151b24] hover:bg-[#11151c] text-white py-2 rounded-xl transition">Cancel</button>
            <button id="savePall" class="cursor-pointer w-1/2 bg-green-500 hover:bg-green-600 text-black font-semibold py-2 rounded-xl transition">Save</button>
        </div>
        <h2 id="showMsg"></h2>
    </article>
</div>